{
  "imports": {
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.47.11"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "deno"
    ],
   
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
   
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true
  },
  "unstable": [
    "sloppy-imports"
  ]
}
